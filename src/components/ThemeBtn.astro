---
---

<button
  id="theme-btn"
  class="ml-1 p-1.5 rounded hover:bg-skin-card-muted transition-colors"
  title="Toggle theme"
  aria-label="Toggle light/dark theme"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    id="sun-svg"
    class="theme-icon hidden h-5 w-5"
    viewBox="0 0 24 24"
    stroke="currentColor"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    id="moon-svg"
    class="theme-icon hidden h-5 w-5"
    viewBox="0 0 24 24"
    stroke="currentColor"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  function setTheme(document: Document) {
    const themeBtn = document.getElementById("theme-btn");
    const sunSvg = document.getElementById("sun-svg");
    const moonSvg = document.getElementById("moon-svg");
    const isDark = document.documentElement.classList.contains("dark");

    if (sunSvg) sunSvg.classList.toggle("hidden", !isDark);
    if (moonSvg) moonSvg.classList.toggle("hidden", isDark);

    themeBtn?.addEventListener("click", () => {
      const isDarkNow = document.documentElement.classList.contains("dark");
      document.documentElement.classList.toggle("dark", !isDarkNow);
      localStorage.setItem("theme", isDarkNow ? "light" : "dark");
      setTheme(document);
    });
  }

  setTheme(document);
  document.addEventListener("astro:after-swap", () => setTheme(document));
</script>
