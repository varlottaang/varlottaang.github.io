---
import { SITE } from "@config";
import ThemeBtn from "./ThemeBtn.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/tags", label: "Tags" },
  { href: "/about", label: "About" },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<!-- In Header.astro, change the nav/header wrapper class -->
<header class="sticky top-0 z-50 bg-white/80 dark:bg-[#1a2035]/80 backdrop-blur-md border-b border-skin-border">

  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a
      href="/"
      class="text-lg font-semibold text-skin-base hover:text-skin-accent transition-colors"
    >
      {SITE.author.split(" ")[0]} <span class="font-light">{SITE.author.split(" ")[1]}</span>
    </a>

    <div class="flex items-center gap-1">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`px-3 py-1.5 rounded text-sm transition-colors ${
              currentPath === href || (href !== "/" && currentPath.startsWith(href))
                ? "text-skin-accent font-medium"
                : "text-skin-base opacity-70 hover:opacity-100 hover:text-skin-accent"
            }`}
          >
            {label}
          </a>
        ))
      }
      <ThemeBtn />
    </div>
  </nav>
</header>
