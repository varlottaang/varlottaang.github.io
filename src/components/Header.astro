---
import { SITE } from "@config";
import ThemeBtn from "./ThemeBtn.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-skin-fill/80 backdrop-blur-md border-b border-skin-border">

  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a
      href="/"
      class="flex flex-col text-skin-base hover:text-skin-accent transition-colors"
    >
      <span class="text-lg font-semibold">
        {SITE.author.split(" ")[0]} <span class="font-light">{SITE.author.split(" ")[1]}</span>
      </span>
      <span class="text-xs text-skin-base text-opacity-60">
        {new URL(SITE.website).hostname}
      </span>
    </a>

    <div class="flex items-center gap-1">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`px-3 py-1.5 rounded text-base transition-colors ${
              currentPath === href || (href !== "/" && currentPath.startsWith(href))
                ? "text-skin-accent font-medium"
                : "text-skin-base text-opacity-70 hover:text-opacity-100 hover:text-skin-accent"
            }`}
          >
            {label}
          </a>
        ))
      }
      <ThemeBtn />
    </div>
  </nav>
</header>
