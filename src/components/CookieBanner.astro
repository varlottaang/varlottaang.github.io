---
import { translations } from "@i18n/translations";
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-skin-fill border-t border-skin-border shadow-lg transition-transform duration-300 z-50">
  <div class="mx-auto max-w-3xl px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex-1">
      <p class="text-sm text-skin-base text-opacity-80">
        <span id="banner-message"></span>
        <a href="/privacy" id="learn-more-link" class="underline text-skin-accent hover:text-skin-accent-hover"></a>.
      </p>
    </div>
    <div class="flex-shrink-0 flex items-center gap-2">
      <button
        id="toggle-language-btn"
        class="w-10 h-10 rounded-full bg-skin-card-muted border border-skin-border flex items-center justify-center text-lg hover:bg-skin-border transition-all"
        title="Toggle language"
      >
        <span id="language-toggle-text">🇬🇧</span>
      </button>
      <button
        id="dismiss-cookie-banner"
        class="px-4 py-2 bg-skin-accent text-white rounded text-sm font-medium hover:opacity-90 transition-opacity"
      >
        <span id="dismiss-button-text"></span>
      </button>
    </div>
  </div>
</div>

<script define:vars={{ translations: JSON.stringify(translations) }}>
  // Multi-language cookie banner
  const COOKIE_BANNER_DISMISSED = "cookieBannerDismissed";
  const BANNER_LANGUAGE = "bannerLanguage";
  const banner = document.getElementById("cookie-banner");
  const dismissButton = document.getElementById("dismiss-cookie-banner");
  const toggleLanguageBtn = document.getElementById("toggle-language-btn");
  const bannerMessage = document.getElementById("banner-message");
  const learnMoreLink = document.getElementById("learn-more-link");
  const dismissButtonText = document.getElementById("dismiss-button-text");
  const languageToggleText = document.getElementById("language-toggle-text");

  const trans = JSON.parse(translations);

  // Detect user language
  function detectLanguage() {
    const saved = localStorage.getItem(BANNER_LANGUAGE);
    if (saved) return saved;

    const browserLang = navigator.language.split("-")[0];
    return browserLang === "it" ? "it" : "en";
  }

  let currentLanguage = detectLanguage();

  function updateBannerText() {
    const lang = trans[currentLanguage];
    bannerMessage.textContent = lang.cookieBanner.message + " ";
    learnMoreLink.textContent = lang.cookieBanner.learnMore;
    dismissButtonText.textContent = lang.cookieBanner.dismiss;
    languageToggleText.textContent = currentLanguage === "en" ? "🇮🇹" : "🇬🇧";
  }

  // Hide banner if already dismissed
  if (localStorage.getItem(COOKIE_BANNER_DISMISSED)) {
    banner?.classList.add("hidden");
  } else {
    updateBannerText();
  }

  // Toggle language
  toggleLanguageBtn?.addEventListener("click", () => {
    currentLanguage = currentLanguage === "en" ? "it" : "en";
    localStorage.setItem(BANNER_LANGUAGE, currentLanguage);
    updateBannerText();
  });

  // Set up dismiss button
  dismissButton?.addEventListener("click", () => {
    localStorage.setItem(COOKIE_BANNER_DISMISSED, "true");
    banner?.classList.add("translate-y-full");
    setTimeout(() => {
      banner?.classList.add("hidden");
    }, 300);
  });
</script>

<style>
  #cookie-banner {
    animation: slideUp 0.3s ease-out;
  }

  #cookie-banner.translate-y-full {
    transform: translateY(100%);
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #cookie-banner,
    #cookie-banner.translate-y-full {
      animation: none;
      transition: none;
      transform: none;
    }
  }
</style>
