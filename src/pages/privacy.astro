---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ColoredHeading from "@components/ColoredHeading.astro";
import { SITE } from "@config";
import { translations } from "@i18n/translations";
---

<Layout
  title={`Privacy & Cookie Policy | ${SITE.title}`}
  description="Privacy and cookie policy for Angelo Varlotta's personal website."
>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <div class="mt-8 mb-2 flex items-center justify-between">
      <a
        href="/"
        class="text-sm text-skin-accent hover:text-skin-accent-hover transition-colors"
      >
        <span id="back-home">← Back to Home</span>
      </a>
      <button
        id="language-toggle"
        class="w-12 h-12 rounded-full bg-skin-card-muted border-2 border-skin-border flex items-center justify-center text-2xl hover:bg-skin-border transition-colors shadow-sm"
      >
        <span id="lang-toggle-text">🇬🇧</span>
      </button>
    </div>

    <article class="mt-10">
      <div class="flex items-center gap-3 mb-8">
        <ColoredHeading level={1} text="Privacy & Cookie Policy" class="text-3xl" id="privacy-title" />
      </div>

      <div class="prose-custom prose dark:prose-invert max-w-none font-sans text-lg leading-relaxed" id="privacy-content">
    </article>
  </main>

  <Footer />
</Layout>

<script define:vars={{ translations: JSON.stringify(translations) }}>
  const trans = JSON.parse(translations);
  const BANNER_LANGUAGE = "bannerLanguage";

  // Detect user language
  function detectLanguage() {
    const saved = localStorage.getItem(BANNER_LANGUAGE);
    if (saved) return saved;

    const browserLang = navigator.language.split("-")[0];
    return browserLang === "it" ? "it" : "en";
  }

  let currentLanguage = detectLanguage();

  const privacyContent = document.getElementById("privacy-content");
  const languageToggle = document.getElementById("language-toggle");
  const langToggleText = document.getElementById("lang-toggle-text");
  const backHome = document.getElementById("back-home");

  function renderPrivacyContent() {
    const lang = trans[currentLanguage];
    const isItalian = currentLanguage === "it";

    const html = `
      <h2>${lang.privacy.overview}</h2>
      <p>${lang.privacy.overviewText}</p>

      <h2>${lang.privacy.whatWeDont}</h2>
      <ul>
        <li><strong>${isItalian ? "Nessuna Analitiche:" : "No Analytics:"}</strong> ${lang.privacy.noAnalytics}</li>
        <li><strong>${isItalian ? "Nessuna Pubblicità:" : "No Advertising:"}</strong> ${lang.privacy.noAdvertising}</li>
        <li><strong>${isItalian ? "Nessun Cookie di Tracciamento:" : "No Tracking Cookies:"}</strong> ${lang.privacy.noTrackingCookies}</li>
        <li><strong>${isItalian ? "Nessuna Vendita di Dati:" : "No Data Selling:"}</strong> ${lang.privacy.noDataSelling}</li>
        <li><strong>${isItalian ? "Nessuna Raccolta di Moduli:" : "No Forms Collection:"}</strong> ${lang.privacy.noForms}</li>
      </ul>

      <h2>${lang.privacy.whatWeDo}</h2>

      <h3>${lang.privacy.themePreference}</h3>
      <p>${lang.privacy.themePreferenceText}</p>

      <h3>${lang.privacy.googleFonts}</h3>
      <p>${lang.privacy.googleFontsText} <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">${isItalian ? "Politica sulla Privacy di Google" : "Google's Privacy Policy"}</a>.</p>

      <h3>${lang.privacy.serverLogs}</h3>
      <p>${lang.privacy.serverLogsText} <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">${isItalian ? "Dichiarazione sulla Privacy di GitHub" : "GitHub's Privacy Statement"}</a>.</p>

      <h2>${lang.privacy.cookiesWeSet}</h2>
      <p><strong>${lang.privacy.cookiesWeSetText}</strong></p>

      <h2>${lang.privacy.yourRights}</h2>
      <p>${lang.privacy.yourRightsText}</p>
      <ul>
        <li>${lang.privacy.clearStorage}</li>
        <li>${lang.privacy.disableJS}</li>
        <li>${lang.privacy.usePrivacyTools}</li>
      </ul>

      <h2>${lang.privacy.thirdPartyLinks}</h2>
      <p>${lang.privacy.thirdPartyLinksText}</p>

      <h2>${lang.privacy.bannerConsent}</h2>
      <p>${lang.privacy.bannerConsentText}</p>

      <h2>${lang.privacy.contact}</h2>
      <p>${lang.privacy.contactText}</p>

      <h2>${lang.privacy.changes}</h2>
      <p>${lang.privacy.changesText}</p>

      <p class="text-sm text-skin-base text-opacity-70 mt-8">
        <em>${lang.privacy.lastUpdated} ${new Date().toLocaleDateString(currentLanguage === "it" ? "it-IT" : "en-US", { year: "numeric", month: "long", day: "numeric" })}</em>
      </p>
    `;

    privacyContent.innerHTML = html;
    langToggleText.textContent = currentLanguage === "en" ? "🇮🇹" : "🇬🇧";
    backHome.textContent = currentLanguage === "en" ? "← Back to Home" : "← Torna alla Home";
  }

  // Initial render
  renderPrivacyContent();

  // Toggle language
  languageToggle?.addEventListener("click", () => {
    currentLanguage = currentLanguage === "en" ? "it" : "en";
    localStorage.setItem(BANNER_LANGUAGE, currentLanguage);
    renderPrivacyContent();
  });
</script>
