---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ColoredHeading from "@components/ColoredHeading.astro";
import { SITE } from "@config";
---

<Layout
  title={`Privacy & Cookie Policy | ${SITE.title}`}
  description="Privacy and cookie policy for Angelo Varlotta's personal website."
>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <div class="mt-8 mb-2">
      <a
        href="/"
        class="text-sm text-skin-accent hover:text-skin-accent-hover transition-colors"
      >
        ← Back to Home
      </a>
    </div>

    <article class="mt-10">
      <ColoredHeading level={1} text="Privacy & Cookie Policy" class="text-3xl mb-8" />

      <div class="prose-custom prose dark:prose-invert max-w-none font-sans text-lg leading-relaxed">
        <h2>Overview</h2>
        <p>
          This website is designed with privacy in mind. We collect minimal data and do not use tracking cookies, analytics, or advertising technologies. This policy explains what limited data we do collect and how it's used.
        </p>

        <h2>What We Don't Do</h2>
        <ul>
          <li><strong>No Analytics:</strong> We do not use Google Analytics, Mixpanel, or any analytics platforms to track your behavior.</li>
          <li><strong>No Advertising:</strong> We do not use Facebook Pixel, LinkedIn Insight Tag, or any advertising pixels.</li>
          <li><strong>No Tracking Cookies:</strong> We do not set tracking cookies to follow you across the web.</li>
          <li><strong>No Data Selling:</strong> We do not sell, trade, or share your personal data with third parties.</li>
          <li><strong>No Forms Collection:</strong> We do not collect personal information through forms (except comments/messages when explicitly provided).</li>
        </ul>

        <h2>What We Do Collect</h2>

        <h3>Theme Preference</h3>
        <p>
          We store your light/dark theme preference in your browser's <code>localStorage</code> (not a cookie). This is purely for convenience—to remember your theme choice when you return. This data never leaves your device.
        </p>

        <h3>Google Fonts</h3>
        <p>
          This website loads fonts from Google Fonts. When you load a page, your browser makes a request to <code>fonts.googleapis.com</code> to fetch font files. Google's privacy policy applies to this request. You can review it at <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.
        </p>

        <h3>Server Logs</h3>
        <p>
          GitHub Pages (where this site is hosted) may collect basic server logs including IP addresses and request data as part of their standard hosting infrastructure. This is outside our control. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub's Privacy Statement</a>.
        </p>

        <h2>Cookies We Set</h2>
        <p>
          <strong>We do not set any cookies on this website.</strong> The theme preference is stored in <code>localStorage</code>, which is separate from cookies.
        </p>

        <h2>Your Rights</h2>
        <p>
          Since we collect minimal data, there is very little to request or delete. However, you can:
        </p>
        <ul>
          <li>Clear your browser's <code>localStorage</code> to reset your theme preference</li>
          <li>Disable JavaScript in your browser to prevent any client-side storage</li>
          <li>Use privacy-focused browsers or extensions to block external requests</li>
        </ul>

        <h2>Third-Party Links</h2>
        <p>
          This website contains links to external sites (Neuromatch, LinkedIn, GitHub, etc.). We are not responsible for the privacy practices of these external sites. We encourage you to review their privacy policies independently.
        </p>

        <h2>Cookie Banner Consent</h2>
        <p>
          Since we do not use cookies for tracking or analytics, you may dismiss the cookie banner at any time. Dismissing it does not affect your ability to use this website—it simply acknowledges that you've been informed about our minimal data practices.
        </p>

        <h2>Contact</h2>
        <p>
          If you have questions about this privacy policy or how your data is handled, you can reach out through the contact links in the footer.
        </p>

        <h2>Changes to This Policy</h2>
        <p>
          This policy may be updated occasionally to reflect changes in our practices or legal requirements. The most recent version is always available on this page. We will not use your information in a way materially different from what was stated at the time of collection without your consent.
        </p>

        <p class="text-sm text-skin-base text-opacity-70 mt-8">
          <em>Last updated: {new Date().toLocaleDateString("en-us", { year: "numeric", month: "long", day: "numeric" })}</em>
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
