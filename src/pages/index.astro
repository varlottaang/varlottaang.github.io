---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostCard from "@components/PostCard.astro";
import { SITE, SOCIALS } from "@config";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDatetime).valueOf() - new Date(a.data.pubDatetime).valueOf())
  .slice(0, 3);

const activeSocials = SOCIALS.filter(s => s.active);
const substackLink = SOCIALS.find(s => s.name === "Substack");
---

<Layout title={SITE.title} description={SITE.desc}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <!-- Hero -->
    <section class="mt-14 mb-12">
      <h1 class="text-3xl font-bold text-skin-base mb-3">Angelo Varlotta</h1>
      <p class="text-base text-skin-base text-opacity-80 leading-relaxed max-w-xl">
        I'm interested in applied machine learning, responsible AI, and sustainability.
        Currently a volunteer at <a href="https://neuromatch.io/team" target="_blank" rel="noopener noreferrer" class="text-skin-accent hover:text-skin-accent-hover underline underline-offset-4 decoration-dashed transition-colors">Neuromatch</a>.
      </p>

      <!-- Social links -->
      <div class="flex gap-3 mt-6">
        {
          activeSocials.map(({ href, name, linkTitle }) => {
            const getIcon = (socialName: string) => {
              switch(socialName) {
                case "LinkedIn":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>`;
                case "GitHub":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`;
                case "Substack":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08V8.242zM1.46 10.812v10.17h21.08v-10.17H1.46zm21.04 11.178H1.5V20.5h21.04v1.49z"/></svg>`;
                case "Bluesky":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-5.5 0-10 3.6-10 8 0 2.5 1.2 4.8 3.2 6.3-.2 1.4-.8 2.8-1.7 3.9 2.4-.7 4.4-2 6-3.6 1 .1 2 .2 3 .2 5.5 0 10-3.6 10-8s-4.5-8-10-8h-1.5z"/></svg>`;
                case "Mastodon":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.898 10.403c0-3.603-2.419-4.688-2.419-4.688-1.219-.562-6.403-1.03-6.479-1.047h-.08c0 0-5.079.457-6.299 1.047 0 0-2.419 1.085-2.419 4.688 0 .41-.013 1.09.68 1.506.342.217 1.273.42 2.324.46 1.603.168 3.07.228 4.275.088l-.113.058c-.032.017-.113.048-.202.117-.339.216-.458.338-.458.587 0 .649.433.927.433.927.389.243 1.148.262 1.466.256h.028c.318.006 1.077-.013 1.466-.256.433-.27.433-.278.433-.927 0-.249-.119-.371-.458-.587-.089-.069-.17-.1-.202-.117l-.113-.058c1.205.14 2.674.08 4.275-.088 1.051-.04 1.982-.243 2.324-.46.692-.416.68-1.096.68-1.506" stroke="currentColor" stroke-width="1" fill="none"/></svg>`;
                default:
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>`;
              }
            };
            return (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                title={linkTitle}
                class="inline-flex items-center justify-center w-8 h-8 rounded border border-skin-border text-skin-base text-opacity-70 hover:text-opacity-100 hover:text-skin-accent hover:border-skin-accent transition-all"
                set:html={getIcon(name)}
              >
              </a>
            )
          })
        }
      </div>
    </section>

    <!-- Featured links -->
    <section class="mb-12">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-skin-base text-opacity-50 mb-4">Work & Contributions</h2>
      <ul class="space-y-3">
        <li>
          <a
            href="https://youtube.com/playlist?list=PLkBQOLLbi18NxJoviTS7T_GHbFTvdqYgT"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">2026 Academy Professional Development</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Neuromatch Academy · YouTube</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://neuromatch.io/team"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Neuromatch Academy</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">People — Neuromatch.io</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://youtu.be/g2upXZxXlrc"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Impact Interview — Lubia Vinhas</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Neuromatch Academy · YouTube</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://askabiologist.asu.edu/la-vita-nello-spazio"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">La vita nello spazio</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Ask A Biologist · Arizona State University</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://askabiologist.asu.edu/mattoni-della-vita"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Mattoni della Vita</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Ask A Biologist · Arizona State University</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
      </ul>
    </section>

    <!-- Recent posts -->
    {
      posts.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-skin-base text-opacity-50">Recent Posts</h2>
            {
              substackLink && (
                <a href={substackLink.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs text-skin-accent hover:text-skin-accent-hover transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08V8.242zM1.46 10.812v10.17h21.08v-10.17H1.46zm21.04 11.178H1.5V20.5h21.04v1.49z"/></svg>
                  Read more on Draw an Owl
                </a>
              )
            }
          </div>
          <ul>
            {posts.map(post => (
              <PostCard post={post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
