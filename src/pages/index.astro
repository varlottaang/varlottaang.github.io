---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostCard from "@components/PostCard.astro";
import { SITE, SOCIALS } from "@config";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDatetime).valueOf() - new Date(a.data.pubDatetime).valueOf())
  .slice(0, 3);

const activeSocials = SOCIALS.filter(s => s.active);
const substackLink = SOCIALS.find(s => s.name === "Substack");
---

<Layout title={SITE.title} description={SITE.desc}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <!-- Hero -->
    <section class="mt-14 mb-12">
      <h1 class="text-3xl font-bold text-skin-base mb-3">Angelo Varlotta</h1>
      <p class="text-base text-skin-base text-opacity-80 leading-relaxed max-w-xl">
         I'm a project manager and consultant. I work at the intersection of machine learning, responsible AI, and sustainability. My focus is on making AI systems more thoughtful, fair, and ecologically aware.

I volunteer at <a href="https://neuromatch.io" target="_blank" rel="noopener noreferrer">Neuromatch</a>, an open-science organization that runs accessible, high-quality computational neuroscience and deep learning courses for researchers worldwide.

      <!-- Social links -->
      <div class="flex gap-3 mt-6">
        {
          activeSocials.map(({ href, name, linkTitle }) => {
            const getIcon = (socialName: string) => {
              switch(socialName) {
                case "LinkedIn":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#0077B5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;
                case "GitHub":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.343-3.369-1.343-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.89 1.529 2.341 1.087 2.91.832.092-.647.349-1.086.635-1.337-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.137 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>`;
                case "Substack":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FF6D00"><path d="M22.539 8.242H1.46V5.406h21.08V8.242zM1.46 10.812v10.17h21.08v-10.17H1.46zm21.04 11.178H1.5V20.5h21.04v1.49z"/></svg>`;
                case "Bluesky":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#1085FE"><path d="M10.5 5c-1.5 0-2.5.5-3.5 1.5C5.5 8 5 9 5 10.5c0 1 .3 2 1 2.7-1 .5-2 1.5-2 3c0 1.7 1.3 3 3 3 .7 0 1.3-.2 1.8-.6.4.4 1 .6 1.7.6 1.7 0 3-1.3 3-3 0-1.5-1-2.5-2-3 .7-.7 1-1.7 1-2.7 0-1.5-.5-2.5-1.5-3.5C13 5.5 12 5 10.5 5zm3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm-6 0c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"/></svg>`;
                case "Mastodon":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#6364FF"><path d="M23.268 5.313c.35-2.467-2.086-4.666-4.33-4.58a15.407 15.407 0 00-5.4 1.007.944.944 0 00-.465.196.938.938 0 00-.195.465 15.41 15.41 0 00-1.006 5.4c.5.413.797 1.05.832 1.687.035.637-.158 1.271-.58 1.77.58.5 1.37.78 2.186.766 1.823-.034 3.646-.034 5.468 0 .816.014 1.608-.266 2.186-.766-.422-.499-.615-1.133-.58-1.77.035-.637.332-1.274.832-1.687a15.41 15.41 0 00-1.006-5.4z"/></svg>`;
                default:
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>`;
              }
            };
            return (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                title={linkTitle}
                class="inline-flex items-center justify-center w-8 h-8 rounded hover:opacity-80 transition-opacity"
                set:html={getIcon(name)}
              >
              </a>
            )
          })
        }
      </div>
    </section>

    <!-- Featured links -->
    <section class="mb-12">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-skin-base text-opacity-50 mb-4">Work & Contributions</h2>
      <ul class="space-y-3">
        <li>
          <a
            href="https://youtube.com/playlist?list=PLkBQOLLbi18NxJoviTS7T_GHbFTvdqYgT"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">2026 Academy Professional Development</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Neuromatch Academy · YouTube</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://neuromatch.io/team"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Neuromatch Academy</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">People — Neuromatch.io</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://youtu.be/g2upXZxXlrc"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Impact Interview — Lubia Vinhas</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Neuromatch Academy · YouTube</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://askabiologist.asu.edu/la-vita-nello-spazio"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">La vita nello spazio</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Ask A Biologist · Arizona State University</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://askabiologist.asu.edu/mattoni-della-vita"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Mattoni della Vita</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Ask A Biologist · Arizona State University</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
      </ul>
    </section>

    <!-- Recent posts -->
    {
      posts.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-skin-base text-opacity-50">Recent Posts</h2>
            {
              substackLink && (
                <a href={substackLink.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs text-skin-accent hover:text-skin-accent-hover transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#FF6D00"><path d="M22.539 8.242H1.46V5.406h21.08V8.242zM1.46 10.812v10.17h21.08v-10.17H1.46zm21.04 11.178H1.5V20.5h21.04v1.49z"/></svg>
                  Read more on Draw an Owl
                </a>
              )
            }
          </div>
          <ul>
            {posts.map(post => (
              <PostCard post={post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
