---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostCard from "@components/PostCard.astro";
import { SITE, SOCIALS } from "@config";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDatetime).valueOf() - new Date(a.data.pubDatetime).valueOf())
  .slice(0, 3);

const activeSocials = SOCIALS.filter(s => s.active);
const substackLink = SOCIALS.find(s => s.name === "Substack");
---

<Layout title={SITE.title} description={SITE.desc}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <!-- Hero -->
    <section class="mt-14 mb-12">
      <h1 class="text-3xl font-bold text-skin-base mb-3">Angelo Varlotta</h1>
      <p class="text-base text-skin-base text-opacity-80 leading-relaxed max-w-xl">
         I'm a project manager and consultant. I work at the intersection of machine learning, responsible AI, and sustainability. My focus is on making AI systems more thoughtful, fair, and ecologically aware.

I volunteer at <a href="https://neuromatch.io" target="_blank" rel="noopener noreferrer">Neuromatch</a>, an open-science organization that runs accessible, high-quality computational neuroscience and deep learning courses for researchers worldwide.

      <!-- Social links -->
      <div class="flex gap-3 mt-6">
        {
          activeSocials.map(({ href, name, linkTitle }) => {
            const getIcon = (socialName: string) => {
              switch(socialName) {
                case "LinkedIn":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#0077B5"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M6 9h3v7H6V9zm1.5-3.5c.828 0 1.5-.672 1.5-1.5S8.328 2.5 7.5 2.5 6 3.172 6 4s.672 1.5 1.5 1.5zm8.5 3.5h3v3.88c0 2.11 1.08 3.62 3 3.62 1.61 0 2.35-.46 2.79-1.25v1.08h3v-7.26c0-3.42-1.94-5.01-4.62-5.01-2.13 0-3.29 1.15-3.79 2h-.1v-1.75h-3.08v7.27z" fill="white"/></svg>`;
                case "GitHub":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.52 1.03 1.52 1.03.88 1.52 2.32 1.08 2.89.82.09-.65.34-1.08.62-1.33-2.22-.25-4.56-1.11-4.56-4.93 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.32.1-2.75 0 0 .84-.27 2.75 1.02.8-.22 1.66-.33 2.5-.33s1.7.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02.55 1.43.2 2.49.1 2.75.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48C19.14 20.16 22 16.42 22 12c0-5.52-4.48-10-10-10z"/></svg>`;
                case "Substack":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#FF6D00"><path d="M2 3h20v2H2V3zm0 4h20v2H2V7zm0 4h20v2H2v-2zm0 4h20v2H2v-2z"/></svg>`;
                case "Bluesky":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#1085FE"><path d="M12 3c-5 0-9 3-9 7 0 2.5 1.5 4.5 3 5.5-.3 1-.8 2-1.5 3 2-.5 4-1.8 5.5-3.5 1 .2 2 .3 3 .3 5 0 9-3 9-7s-4-8-9-8z"/></svg>`;
                case "Mastodon":
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#6364FF"><path d="M21.3 6.8c0-4.4-2.8-5.7-2.8-5.7-1.4-.6-7.5-.8-7.5-.8s-6.1.2-7.5.8c0 0-2.8 1.3-2.8 5.7 0 4.9-.2 9 .2 9.8 1 2.5 3.7 2.7 6.8 2.8 3.3.1 6-1 6-1l-.1-2s-2.7.9-5.8.8c-3 0-6-.3-6.4-1.6-.2-.7-.2-1.8-.2-3v-4.2c0 0 2.7.6 5.8.8 3.3.2 6-.2 6-.2v3.2c0 0-1 1.5-4.2 1.8-2 .2-4.2.1-6.2-.4v5c0 0 2.7 1.3 6 1.4 3 .1 5.8-1 5.8-1 .4-1 .6-5 .6-9.1z"/></svg>`;
                default:
                  return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>`;
              }
            };
            return (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                title={linkTitle}
                class="inline-flex items-center justify-center w-8 h-8 rounded hover:opacity-80 transition-opacity"
                set:html={getIcon(name)}
              >
              </a>
            )
          })
        }
      </div>
    </section>

    <!-- Featured links -->
    <section class="mb-12">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-skin-base text-opacity-50 mb-4">Work & Contributions</h2>
      <ul class="space-y-3">
        <li>
          <a
            href="https://youtube.com/playlist?list=PLkBQOLLbi18NxJoviTS7T_GHbFTvdqYgT"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">2026 Academy Professional Development</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Neuromatch Academy · YouTube</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://neuromatch.io/team"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Neuromatch Academy</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">People — Neuromatch.io</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://youtu.be/g2upXZxXlrc"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Impact Interview — Lubia Vinhas</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Neuromatch Academy · YouTube</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://askabiologist.asu.edu/la-vita-nello-spazio"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">La vita nello spazio</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Ask A Biologist · Arizona State University</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://askabiologist.asu.edu/mattoni-della-vita"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between py-3 border-b border-skin-border hover:border-skin-accent transition-colors"
          >
            <div>
              <p class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Mattoni della Vita</p>
              <p class="text-xs text-skin-base text-opacity-60 mt-0.5">Ask A Biologist · Arizona State University</p>
            </div>
            <span class="text-skin-base text-opacity-40 group-hover:text-opacity-70 transition-opacity text-xs mt-0.5">↗</span>
          </a>
        </li>
      </ul>
    </section>

    <!-- Recent posts -->
    {
      posts.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-skin-base text-opacity-50">Recent Posts</h2>
            {
              substackLink && (
                <a href={substackLink.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs text-skin-accent hover:text-skin-accent-hover transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#FF6D00"><path d="M22.539 8.242H1.46V5.406h21.08V8.242zM1.46 10.812v10.17h21.08v-10.17H1.46zm21.04 11.178H1.5V20.5h21.04v1.49z"/></svg>
                  Read more on Draw an Owl
                </a>
              )
            }
          </div>
          <ul>
            {posts.map(post => (
              <PostCard post={post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
