---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const tagCounts: Record<string, number> = {};

posts
  .filter(p => !p.data.draft)
  .forEach(post => {
    post.data.tags?.forEach((tag: string) => {
      tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
    });
  });

const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Layout title={`Tags | ${SITE.title}`} description="Browse posts by tag.">
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-16">
    <section class="mt-10">
      <h1 class="text-2xl font-bold text-skin-base mb-8">Tags</h1>

      <div class="flex flex-wrap gap-3">
        {
          tags.map(([tag, count]) => (
            <a
              href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
              class="flex items-center gap-1.5 px-3 py-1.5 rounded border border-skin-border text-skin-accent hover:border-skin-accent hover:bg-skin-card-muted transition-all text-sm"
            >
              #{tag}
              <span class="text-xs text-skin-base text-opacity-50">({count})</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
